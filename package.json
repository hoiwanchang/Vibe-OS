{
  "name": "vibeos-backend",
  "version": "0.1.0",
  "description": "Vibe OS — 开源私有 AI NAS 系统后端服务",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "web:dev": "pnpm --filter vibeos-web dev",
    "web:build": "pnpm --filter vibeos-web build",
    "web:lint": "pnpm --filter vibeos-web lint",
    "web:test": "pnpm --filter vibeos-web test"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "jose": "^6.2.4",
    "mime-types": "^3.0.2",
    "multer": "^2.2.0",
    "music-metadata": "^11.14.0",
    "nanoid": "^6.0.0",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.1"
  }
}
