# ============================================================================
# NAISys ISO 构建配置
# 所有可变参数集中于此，供 build-iso.sh / verify-iso.sh 读取
# ============================================================================

# --- Debian 基线 ---
DEBIAN_SUITE="trixie"
DEBIAN_VERSION="13.3.0"
DEBIAN_ARCH="amd64"

# 官方 netinst 镜像（CI 与本地均可覆盖此变量指向内网镜像）
DEBIAN_MIRROR="${DEBIAN_MIRROR:-https://cdimage.debian.org/debian-cd}"
NETINST_URL="${DEBIAN_MIRROR}/${DEBIAN_VERSION}/${DEBIAN_ARCH}/iso-cd/debian-${DEBIAN_VERSION}-${DEBIAN_ARCH}-netinst.iso"
NETINST_SHA_URL="${NETINST_URL}.SHA256SUMS"

# --- 输出 ---
ISO_NAME="naisys"
ISO_LABEL="NAISYS"
# 输出文件名模板，{version} 由脚本替换
ISO_OUT_PATTERN="${ISO_NAME}-{version}-${DEBIAN_ARCH}.iso"

# --- 默认安装参数（可被构建时环境变量覆盖）---
DEFAULT_HOSTNAME="ai-nas"
DEFAULT_USER="admin"
# 初始密码策略：build 时若未提供 NAISYS_INIT_PASSWORD，则随机生成并烘焙进介质
# 绝不在此硬编码真实密码
DEFAULT_DATA_FSTYPE="xfs"

# --- 预装固件包（消费级网卡驱动，注入 initrd）---
# RTL8125/8156 (Realtek 2.5G)  -> firmware-realtek (r8125/r8169)
# Intel i225/i226 (igc)         -> firmware-misc-nonfree 不含，igc 驱动内核自带，固件无需
# Mellanox ConnectX-3/4 (mlx4/mlx5) -> firmware-misc-nonfree + 内核自带 mlx 驱动
FIRMWARE_PACKAGES="firmware-realtek firmware-misc-nonfree firmware-linux-nonfree"

# --- 预装运行时软件包（安装进目标系统）---
# 见 packages/runtime-packages.txt

# --- OTA / Release ---
GITHUB_REPO="${GITHUB_REPO:-NAISys/NAISys}"
OTA_RELEASE_API="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"

# --- 校验 ---
SHA_ALGO="sha256"